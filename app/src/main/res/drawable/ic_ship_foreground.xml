<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: a stylized GOLD PIRATE SHIP, matching The Cap's gold-on-black theme.
  The art is derived from the phone app's car-card ship SVG (ids psHull/psSail/psMast/psSea in
  The Cap Android/app/src/main/assets/web/app.js), simplified for launcher sizes. Authored in the
  original 420x220 coordinate space and scaled into the 108x108 safe zone by the <group>.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="0.27"
        android:scaleY="0.27"
        android:pivotX="225.5"
        android:pivotY="109"
        android:translateX="-171.5"
        android:translateY="-55">

        <!-- Masts, spars and crow's-nest top: one path, gold left-dark / center-bright gradient. -->
        <path android:pathData="M148,72 h4 v92 h-4 z M208,42 h5 v122 h-5 z M268,68 h4 v96 h-4 z M120,92 h60 v3.5 h-60 z M128,123 h48 v3.5 h-48 z M176,62 h70 v4 h-70 z M184,103 h56 v4 h-56 z M244,88 h56 v3.5 h-56 z M250,122 h44 v3.5 h-44 z M202,58 h18 v8 h-18 z">
