                    <item android:offset="0" android:color="#FF8A5F2E"/>
                    <item android:offset="0.5" android:color="#FF5A3C1C"/>
                    <item android:offset="1" android:color="#FF1E1002"/>
                </gradient>
            </aapt:attr>
        </path>

        <!-- Stern castle. -->
        <path android:pathData="M89,165 L89,145 C89,141 92,139 97,139 L120,139 C124,139 126,142 126,147 L126,164 Z" android:fillColor="#FF2E1C0B"/>

        <!-- Gold deck gunwale highlight. -->
        <path android:pathData="M95,163 L320,163 L318,157 L99,157 Z" android:fillColor="#FFE2C072"/>
    </group>
